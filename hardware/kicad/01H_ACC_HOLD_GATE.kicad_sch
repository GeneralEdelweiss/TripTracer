(text "PROTOTYPE: ACC resistor divider + D911 BAT54 (A=1, K=2) starts EN independent of 5V. Opto U911 powered by VIN permits post-ACC MCU_HOLD only during independent 555 grant. Q912/Q913 double NPN stage generates non-inverted 3V3 ACC sense for the existing 555 falling-edge trigger; no CTR assumption." (at 29.21 27.94 0) (effects (font (size 1.27 1.27))) (uuid "79ac0001-0000-4000-8000-000000000059"))
(text "CRITICAL: photocoupler U911 VCEO, CTR at -40C and LED current; Q912/Q913 BJT beta, VBE at hot/cold, ACC base resistor leakage, exact pinout/footprint, 9V and 30V thresholds, ACC transient protection, 01C 555 proper trigger and 3V3 power, power-on behavior ALL REQUIRE VERIFICATION. DO NOT FABRICATE." (at 29.21 35.56 0) (effects (font (size 1.27 1.27))) (uuid "79ac0001-0000-4000-8000-000000000060")) (symbol (lib_id "TripTracer_V1:MMBT5551") (at 132.08 146.05 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "79ac0001-0000-4000-8000-000000000300") (property "Reference" "Q912" (at 132.08 128.27 0) (effects (font (size 1.27 1.27)))) (property "Value" "MMBT5551" (at 132.08 130.81 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "Tripmaster:Q_SOT23_1B2E3C" (at 132.08 146.05 0) (effects (font (size 1.27 1.27)) (hide yes))) (pin "1" (uuid "79ac0001-0000-4000-8000-000000000301"))(pin "2" (uuid "79ac0001-0000-4000-8000-000000000302"))(pin "3" (uuid "79ac0001-0000-4000-8000-000000000303")) (instances (project "TripTracer_V1" (path "/a26d9b0c-7f10-4e5a-a65f-000000000064/a26d9b0c-7f10-4e5a-a65f-000000000065" (reference "Q912") (unit 1)))))
