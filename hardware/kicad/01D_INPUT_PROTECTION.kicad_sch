(instances (project "TripTracer_V1" (path "/a26d9b0c-7f10-4e5a-a65f-000000000064/a26d9b0c-7f10-4e5a-a65f-000000000065/72346f29-23d6-4849-8604-2156cfdc44a1" (reference "U401") (unit 1)))))
(text "BAUGRUPPE 01D - TPS26631 PWP 20pin SYMBOL / BAUTEILKANDIDAT - NOCH KEINE FUNKTIONSSCHALTUNG!" (at 206 26 0) (effects (font (size 1.6 1.6))) (uuid "72346f29-23d6-4849-8604-000000001200"))
(text "BAT_SW_BEFORE_EFUSE -> BLOCKING FET (SOURCE=IN_SYS,DRAIN=IN,GATE=B_GATE) -> U401 -> HV_PROTECTED_AFTER_EFUSE." (at 206 38 0) (effects (font (size 1.15 1.15))) (uuid "72346f29-23d6-4849-8604-000000001201"))
(text "Q2 DRV/B_GATE/IN_SYS PULLDOWN-FET, AUTO-RETRY MODE=GND, DvDT/ILIM/UVLO/OVP VORLAEUFIG OFFEN." (at 206 50 0) (effects (font (size 1.15 1.15))) (uuid "72346f29-23d6-4849-8604-000000001202"))
(text "1.38mA typ ON: U401 NUR hinter K101. NIE dauerhaft an BAT+ im OFF unter 100uA Ziel." (at 206 62 0) (effects (font (size 1.15 1.15))) (uuid "72346f29-23d6-4849-8604-000000001203"))
(text "Immer-aktive LM5164 AUX-Versorgung braucht separate passende Kfz-Schutzkette VOR Relaiskontakt." (at 206 74 0) (effects (font (size 1.15 1.15))) (uuid "72346f29-23d6-4849-8604-000000001204"))
(text "Unter 9V Kaltstart und >36V Load-Dump weitere Schutz- und Speicherprüfung nötig." (at 206 86 0) (effects (font (size 1.15 1.15))) (uuid "72346f29-23d6-4849-8604-000000001205"))
(text "Die Steckverbinder-/Power-Rails dürfen NICHT so verbunden werden, als gäbe es ein fertiges Verpolschutzdesign." (at 206 98 0) (effects (font (size 1.15 1.15))) (uuid "72346f29-23d6-4849-8604-000000001206"))
(text "ERC/DRC NICHT gelaufen; KEIN FINISHED INPUT PROTECTION, nicht für Fahrzeuge/Fertigung freigegeben." (at 206 110 0) (effects (font (size 1.15 1.15))) (uuid "72346f29-23d6-4849-8604-000000001207"))
