(text "U301 TPS2116 DRL8: VIN1 BUCK -> PRIORITY (PR1=VIN1, MODE=VIN1), VIN2 USB VBUS, reverse-current blocking. Voltage domain 1.6..5.5V ONLY. Device USB requires upstream 5V current budget/ESD. U302 NCV1117 3V3 requires minimum-load/ESR and thermal test." (at 27 33 0) (effects (font (size 1.27 1.27))) (uuid "33aacc00-0000-4000-8000-000000000051"))
(text "ALERT: U301 is SOT-5X3 2.1x1.6mm, hand soldering difficult; U302 3V3 LDO at 0.4A dissipates 0.68W and needs copper. Firmware must only allow USB SD-MSC when no simultaneous logger SD mount. ERC/DRC/protection NOT APPROVED." (at 27 41 0) (effects (font (size 1.27 1.27))) (uuid "33aacc00-0000-4000-8000-000000000052")) (symbol (lib_id "Tripmaster_Sym:R") (at 190.5 144.78 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "33aacc00-0000-4000-8000-000000000060") (property "Reference" "R306" (at 190.5 130.78 0) (effects (font (size 1.27 1.27)))) (property "Value" "10k ST open drain pullup" (at 190.5 133.38 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "Tripmaster:R_1206_3216" (at 190.5 144.78 0) (effects (font (size 1.27 1.27)) (hide yes))) (pin "1" (uuid "33aacc00-0000-4000-8000-000000000061")) (pin "2" (uuid "33aacc00-0000-4000-8000-000000000062")) (instances (project "TripTracer_V1" (path "/a26d9b0c-7f10-4e5a-a65f-000000000064/a26d9b0c-7f10-4e5a-a65f-000000000067" (reference "R306") (unit 1)))))
