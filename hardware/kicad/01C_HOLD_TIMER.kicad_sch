(text "01C MONOSTABLE HARDWARE HOLD WINDOW - SUBCIRCUIT, NOT SYSTEM-VALIDATED" (at 204.47 21.59 0) (effects (font (size 1.6 1.6))) (uuid "904589dd-1583-4001-acce-000000000119"))
(text "ACC_DRIVE_5V falls -> C502/R502 generates a SHORT LOW TRIG pulse; TRIG must RETURN HIGH." (at 204.47 30.48 0) (effects (font (size 1.15 1.15))) (uuid "904589dd-1583-4001-acce-000000000120"))
(text "TLC555-Q1 RESET has delayed startup (R503/C503) to suppress first-boot false trigger." (at 204.47 39.37 0) (effects (font (size 1.15 1.15))) (uuid "904589dd-1583-4001-acce-000000000121"))
(text "Timer OUT high only during window; U502 output = timer_window AND MCU_HOLD_REQ." (at 204.47 49.53 0) (effects (font (size 1.15 1.15))) (uuid "904589dd-1583-4001-acce-000000000122"))
(text "MCU_HOLD_REQ must be active WHILE ACC is high; goes low immediately after SD unmount." (at 204.47 59.69 0) (effects (font (size 1.15 1.15))) (uuid "904589dd-1583-4001-acce-000000000123"))
(text "TYP MAX WINDOW 1.1*2.2M*10uF=24.2s; real MLCC bias/temp may shorten substantially." (at 204.47 276.86 0) (effects (font (size 1.15 1.15))) (uuid "904589dd-1583-4001-acce-000000000124"))
(text "ACC_DRIVE_5V driven by Q912/Q913 from active 01H; both D501/D502 clamps must be verified." (at 204.47 284.48 0) (effects (font (size 1.15 1.15))) (uuid "904589dd-1583-4001-acce-000000000125"))
(text "Native KiCad 10 ERC run; project contains unresolved violations. 555 signal function not bench tested. Do NOT order PCBA." (at 204.47 290.83 0) (effects (font (size 1.15 1.15))) (uuid "904589dd-1583-4001-acce-000000000126"))
