(text "USB-C CC1/CC2 = 5.1k to GND, VBUS -> USB-only power path, USBLC6-2SC6 ESD." (at 200 30 0) (effects (font (size 1.4 1.4))) (uuid "5ec18d7a-826f-4b31-8e76-000000002fdc"))
(text "BOOT0_RECOVERY / EN_RESET bisher nur Testnetze; physische Jumper/Taster samt Pulls noch zu ergaenzen." (at 200 37 0) (effects (font (size 1.3 1.3))) (uuid "5ec18d7a-826f-4b31-8e76-000000002fdd"))
