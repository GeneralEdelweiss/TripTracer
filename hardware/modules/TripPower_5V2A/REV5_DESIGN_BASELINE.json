  "provisional_stop_gates": [
    {
      "id": "P01",
      "severity": "CRITICAL",
      "item": "9V startup VS dynamic I(VS,t) and 200V pulse behavior",
      "needed": "Supplier bound or real scope bench proof over 9–30V startup and temperature"
    },
