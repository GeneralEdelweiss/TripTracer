  "provisional_stop_gates": [
    {
      "id": "P01",
      "severity": "CRITICAL",
      "item": "9V startup VS dynamic I(VS,t) and 202V pulse behavior",
      "needed": "Supplier bound or real scope bench proof over 9–30V startup and temperature"
    },
    {
      "id": "P02",
      "severity": "CRITICAL",
      "item": "REV4 Q303-Q305 µA hFE and 125°C OFF leakage",
      "needed": "Guaranteed small-current transfer/leak or qualified replacement; LM74930 EN_OFF <=0.41V and EN_ON >=1.05V"
    },
    {
      "id": "P03",
      "severity": "CRITICAL",
      "item": "Q301 250V/202V-350ms switching SOA and Q302 60V plus clamp peaks",
      "needed": "Measured gate/drain transient and hot SOA/vds tolerance"
    },
    {
      "id": "P04",
      "severity": "CRITICAL",
      "item": "R313–R315 2512 pulse energy and 56V D301 clamp at 202V",
      "needed": "Manufacturer 350ms pulse-temperature curves, Zener thermal energy and VS<65V"
    },
    {
      "id": "P05",
      "severity": "CRITICAL",
      "item": "F_MAIN 12V/24V cable fault+I²t and fault-short",
      "needed": "Select external serviceable fuse; cable/copper/connector ratings incl worst temp"
    },
    {
      "id": "P06",
      "severity": "HIGH",
      "item": "C308/C312 Ceff at DC bias/temperature/aging and leakage; C311 time capacitor",
      "needed": "KYOCERA AVX SpiCat C(V,T) and KEMET K-SIM or signed minimum value. 21uF only nominal."
    },
    {
      "id": "P07",
      "severity": "HIGH",
      "item": "C306 47uF/63V and Q302/D301 protective domain",
      "needed": "C306 exact automotive MPN and transient withstand; Q302/TVS/Zener stress check"
    },
    {
      "id": "P08",
      "severity": "HIGH",
      "item": "Buck/output 5V/2A thermal / inductor saturation / ripple and dynamic 0–1A RAW",
      "needed": "Layout thermals, 9–30V transient scope 0..2A, hot current derating"
    },
    {
      "id": "P09",
      "severity": "HIGH",
      "item": "Real standalone KiCad PCB absent: footprints, mechanical, routing, DRC",
      "needed": "Create routed KiCad10 PCB, independent native DRC/ERC, verify solder profiles and test points"
    },
    {
      "id": "P10",
      "severity": "HIGH",
      "item": "RUN_CMD with VIN=0, AUTO/RUN, reset timing, OFF current",
      "needed": "No backfeed / OFF <100uA system gate / partial C311 residual-charge restart across temperature"
    }
  ],
