(text "REV6 Weg B Round12 ISOLATED SAFETY PROTOTYPE / NO FAB / NO VEHICLE" (at 35.96 25.96 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000282"))
(text "HV safety power: VIN_SAFETY_FUSED must be PRE-Q201 but AFTER external source fuse." (at 35.96 35.96 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000283"))
(text "Thermal: TMP390 SETA=SETB to R303 24.9k = HOT 74C nominal, HYST 5C; output LOW at HOT." (at 35.96 43.96 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000284"))
