(text "REV6 Weg B Round12 ISOLATED SAFETY PROTOTYPE / NO FAB / NO VEHICLE" (at 35 25 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000282"))
(text "HV safety power: VIN_SAFETY_FUSED must be PRE-Q201 but AFTER external source fuse." (at 35 35 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000283"))
(text "Thermal: TMP390 SETA=SETB to R303 24.9k = HOT 74C nominal, HYST 5C; output LOW at HOT." (at 35 43 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000284"))
(text "SHDN default OFF: R306 from VIN_SAFETY_FUSED biases Q301 ON; Q302 suppresses Q301 only when TEMP_OK_OD HIGH." (at 35 51 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000285"))
(text "RAW: LTC4368HMS-2; RETRY=GND hardware LATCH; Q403 needs host ACC_OFF hardware HIGH for SHDN reset." (at 35 370 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000286"))
