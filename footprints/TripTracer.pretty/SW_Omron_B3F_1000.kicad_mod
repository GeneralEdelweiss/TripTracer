(footprint "SW_Omron_B3F_1000" (version 20240108) (generator "pcbnew") (layer "F.Cu")
 (descr "Omron B3F-1000 tactile THT 6x6mm height 4.3mm, hole grid 6.5x4.5 dia1mm | Status: HERSTELLER_GEO_GEHAEUSEPASSUNG_PRUEFEN")
 (tags "Tripmaster")
 (attr through_hole)
 (fp_text reference "SW" (at 0 -5.000) (layer "F.SilkS") (effects (font (size 0.9 0.9) (thickness 0.13))))
 (fp_text value "SW_Omron_B3F_1000" (at 0 5.000) (layer "F.Fab") (effects (font (size 0.7 0.7) (thickness 0.1))))
(fp_rect (start -3.000 -3.000) (end 3.000 3.000) (stroke (width 0.100) (type default)) (fill none) (layer "F.Fab"))
(fp_rect (start -4.350 -3.600) (end 4.350 3.600) (stroke (width 0.050) (type default)) (fill none) (layer "F.CrtYd"))
(fp_circle (center 0.000 0.000) (end 1.750 0.000) (stroke (width 0.100) (type default)) (fill none) (layer "F.Fab"))
(pad "4" thru_hole circle (at -3.250 -2.250) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
(pad "2" thru_hole circle (at -3.250 2.250) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
(pad "1" thru_hole circle (at 3.250 2.250) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
(pad "3" thru_hole circle (at 3.250 -2.250) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))

(model "${TRIPTRACER_LIB}/3dmodels/Omron_B3F_1000.step"
 (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
